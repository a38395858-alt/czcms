# Development binds to loopback and uses HTTP-only development cookies.
CZCMS_ENV=development
CZCMS_HTTP_ADDR=127.0.0.1:8080
CZCMS_DB_PATH=var/data/czcms.db

# Production requires independent random keys. Generate each with 32 random
# bytes encoded as Base64. Do not commit real values.
CZCMS_MASTER_KEY=
CZCMS_BACKUP_KEY=
CZCMS_SETUP_TOKEN=

CZCMS_COOKIE_SECURE=false
CZCMS_PUBLIC_HTTPS=false
CZCMS_LOCAL_PREVIEW_LISTENERS=true
CZCMS_TLS_CERT_FILE=
CZCMS_TLS_KEY_FILE=
CZCMS_TRUSTED_PROXIES=

# Redis ACL/TLS. Production requires username + password and requires TLS for
# any non-loopback Redis address.
CZCMS_REDIS_ADDR=
CZCMS_REDIS_USERNAME=
CZCMS_REDIS_PASSWORD=
CZCMS_REDIS_DB=0
CZCMS_REDIS_TLS=false
CZCMS_REDIS_TLS_SERVER_NAME=
CZCMS_REDIS_CA_FILE=

CZCMS_SESSION_IDLE_TTL=30m
CZCMS_SESSION_ABSOLUTE_TTL=12h
CZCMS_MAX_UPLOAD_MB=12
CZCMS_MAX_THEME_MB=50
CZCMS_ANTIVIRUS_COMMAND=

# Optional OpenAI-compatible SEO assistant. Leave all three blank to generate
# deterministic SEO defaults from the article. Remote endpoints require HTTPS
# and an API key; loopback endpoints may omit the key for a local model.
CZCMS_AI_BASE_URL=
CZCMS_AI_API_KEY=
CZCMS_AI_MODEL=
# Long-form translation and SEO extraction can take a while; the application
# defaults to the maximum supported 120 seconds when this variable is omitted.
CZCMS_AI_REQUEST_TIMEOUT=120s
